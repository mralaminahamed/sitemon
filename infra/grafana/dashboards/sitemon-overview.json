      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "sitemon-prom"
          },
          "expr": "sum(rate(sitemon_checks_total{status=\"UP\"}[15m])) / clamp_min(sum(rate(sitemon_checks_total[15m])), 0.0001)",
