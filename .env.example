# Sitemon Configuration Environment Variables
# Copy this file to .env and customize as needed

# Default URL for health checks
SITEMON_URL=

# Default number of concurrent workers
SITEMON_WORKERS=10

# Default requests per second limit
SITEMON_RPS=100

# Default timeout in seconds
SITEMON_TIMEOUT=10

# Log level (debug, info, warn, error)
SITEMON_LOG_LEVEL=info

# Log file path (optional)
SITEMON_LOG_FILE=

# Output format (text, json)
SITEMON_OUTPUT_FORMAT=text

# Default HTTP method (GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS)
SITEMON_METHOD=GET

# Skip TLS verification
SITEMON_TLS_INSECURE=false

# History database path
SITEMON_DB_PATH=

# Webhook URL for alerts (Slack, Discord, Telegram)
SITEMON_WEBHOOK_URL=

# Max latency threshold before alert (e.g., 2s, 500ms)
SITEMON_MAX_LATENCY=
