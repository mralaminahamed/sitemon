# ── Sitemon Platform — environment ─────────────────────────────────────────
# Copy to .env and adjust. Compose overrides the *_URI/*_URL host parts with
# docker-internal hostnames automatically.

# --- Services ---
PORT=8080
LOG_LEVEL=info

# --- MongoDB (Phase 3) ---
MONGO_USER=sitemon
MONGO_PASSWORD=sitemon
MONGO_DB=sitemon
MONGO_URI=mongodb://sitemon:sitemon@localhost:27099/sitemon?authSource=admin
# Days to retain check history (TTL index); 0 disables expiry.
HISTORY_TTL_DAYS=30

# --- Redis (Phase 3) ---
REDIS_URL=redis://localhost:6399/0
# Prod only (docker-compose.prod.yml): change from the default before deploying.
REDIS_PASSWORD=sitemon

# --- NATS (Phase 2) ---
NATS_URL=nats://localhost:4299
# Prod only: change from the defaults before deploying.
NATS_USER=sitemon
NATS_PASSWORD=sitemon

# --- AI service (Phase 5) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Alerts (optional) ---
WEBHOOK_URL=
# Required only for Telegram webhooks.
TELEGRAM_CHAT_ID=
# Consecutive non-UP checks before a "down" alert fires (flap damping).
ALERT_FAILURE_THRESHOLD=2

# --- Scheduler (Phase 2/3) ---
SCHEDULE_CRON=*/5 * * * *
SCHEDULE_URLS=https://example.com

# --- Gateway security ---
# Set to require X-API-Key (or Bearer) on /api. Unset = open (dev only).
GATEWAY_API_KEY=
# Allow fetching private/loopback/link-local targets (dev/testing only).
ALLOW_PRIVATE_TARGETS=false

# Gateway CORS: comma-separated allowed origins (unset = allow all, dev only)
CORS_ORIGINS=

# --- Edge (prod) ---
# Caddy site address: ":80" = plain HTTP; a domain enables automatic HTTPS.
SITE_ADDRESS=:80
